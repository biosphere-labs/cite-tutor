@startuml Cite-Tutor Simplified Architecture
!theme cyborg-outline
skinparam backgroundColor #0D1117
skinparam defaultFontSize 12
skinparam defaultFontColor #F0F6FC

' Package styling - sleek gradient boxes
skinparam packageBackgroundColor #161B22
skinparam packageBorderColor #30363D
skinparam packageFontColor #F0F6FC
skinparam packageFontSize 13
skinparam packageStyle Rectangle

' Component styling - modern cards
skinparam componentBackgroundColor #21262D
skinparam componentBorderColor #58A6FF
skinparam componentFontColor #F0F6FC
skinparam componentFontSize 11
skinparam componentStyle Rectangle

' Arrow styling
skinparam ArrowColor #58A6FF
skinparam ArrowFontColor #F0F6FC
skinparam ArrowFontSize 9

' Note styling
skinparam noteBackgroundColor #1F2937
skinparam noteBorderColor #F59E0B
skinparam noteFontColor #F9FAFB

!define TITLE_COLOR #F0F6FC
skinparam titleFontColor #F0F6FC
skinparam titleFontSize 16

title <color:#58A6FF><b>Cite-Tutor</b></color>: AI-Powered Academic Research Assistant

' Define color scheme - GitHub Dark inspired
!define PRIMARY #58A6FF
!define SECONDARY #F85149
!define ACCENT #F59E0B

package "Development & Training" as dev_train {
    [CLI Interface] as cli
    [Domain Config] as config
    [AWS Spot Fleet\nTraining] as training
}

package "AI Pipeline" as pipeline {
    [Document\nProcessing] as doc_proc
    [Citation\nExtraction] as citations
    [Model\nFine-Tuning] as fine_tune
    [Knowledge\nBase] as kb
}

package "Integration Layer" as integration {
    [MCP Server] as mcp
    [OpenAI/Claude\nEnhancement] as ai_enhance
    [Citation\nValidation] as validation
}

package "User Experience" as ux {
    [Research\nAssistant] as assistant
    [Real-time\nPaper Lookup] as lookup
    [Verified\nResponses] as responses
}

' Main flow connections
cli --> training : "Configure &\nTrain Models"
config --> training : "Multi-Domain\nSupport"
training --> fine_tune : "Cost-Optimized\nGPU Training"

doc_proc --> citations : "Extract &\nValidate"
citations --> fine_tune : "Training\nData"
fine_tune --> kb : "Domain\nExpertise"

kb --> mcp : "Trained\nModels"
mcp --> ai_enhance : "Citation\nCapabilities"
mcp --> validation : "Fact\nChecking"

ai_enhance --> assistant : "Enhanced\nAI Systems"
validation --> lookup : "Real-time\nRetrieval"
lookup --> responses : "Grounded\nAnswers"

note top of dev_train
**Technical Innovation**
• Sub-$1 training costs
• Multi-domain AI system
• AWS spot fleet automation
end note

note right of integration
**Modern AI Integration**
• MCP plugin architecture
• Enhance existing AI systems
• Citation validation engine
end note

note bottom of ux
**User Value**
• No citation hallucination
• Verified academic sources
• Real-time paper retrieval
end note

@enduml