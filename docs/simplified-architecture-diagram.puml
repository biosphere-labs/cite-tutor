@startuml Cite-Tutor Simplified Architecture
!theme cyborg-outline
skinparam backgroundColor #0D1117
skinparam defaultFontSize 12
skinparam defaultFontColor #F0F6FC

' Package styling - sleek gradient boxes
skinparam packageBackgroundColor #161B22
skinparam packageBorderColor #30363D
skinparam packageFontColor #F0F6FC
skinparam packageFontSize 13
skinparam packageStyle Rectangle

' Component styling - modern cards
skinparam componentBackgroundColor #21262D
skinparam componentBorderColor #58A6FF
skinparam componentFontColor #F0F6FC
skinparam componentFontSize 11
skinparam componentStyle Rectangle

' Arrow styling
skinparam ArrowColor #58A6FF
skinparam ArrowFontColor #F0F6FC
skinparam ArrowFontSize 9

' Note styling
skinparam noteBackgroundColor #1F2937
skinparam noteBorderColor #F59E0B
skinparam noteFontColor #F9FAFB

!define TITLE_COLOR #F0F6FC
skinparam titleFontColor #F0F6FC
skinparam titleFontSize 16

title <color:#58A6FF><b>Cite-Tutor</b></color>: AI-Powered Academic Research Assistant

' Define color scheme - GitHub Dark inspired
!define PRIMARY #58A6FF
!define SECONDARY #F85149
!define ACCENT #F59E0B

' Compact 2x2 layout for LinkedIn
left to right direction

package "Training & Setup" as setup {
    [AWS Spot Fleet] as training
    [Multi-Domain\nConfig] as config
    [Sub-$1 Training] as cost
}

package "Core AI Engine" as engine {
    [Citation\nExtraction] as extract
    [Knowledge\nBase] as kb
    [Fact\nValidation] as validate
}

package "User Interface" as ui {
    [Research\nAssistant] as assistant
    [Real-time\nRetrieval] as retrieval
    [Verified\nAnswers] as answers
}

package "AI Integration" as integration {
    [MCP Plugin] as mcp
    [OpenAI/Claude\nEnhancement] as enhance
    [Citation Tools] as tools
}

' Logical flow connections
training --> extract : "Trained\nModels"
config --> extract : "Domain\nPatterns"
cost --> kb : "Cost-Effective\nTraining"

extract --> validate : "Citations"
kb --> validate : "Knowledge"
validate --> assistant : "Verified\nData"

assistant --> retrieval : "Query\nProcessing"
retrieval --> answers : "Real-time\nLookup"
validate --> answers : "Fact\nChecking"

' Integration layer connections
assistant --> mcp : "Core AI"
retrieval --> tools : "Lookup API"
answers --> enhance : "Verified\nResponses"

note top of setup
**Cost-Optimized Training**
• AWS Spot Fleet ($0.88)
• Multi-domain AI
end note

note top of ui
**User Value**
• Real-time retrieval
• Zero hallucination
end note

note bottom of integration
**AI Ecosystem**
• MCP plugin for OpenAI/Claude
• Citation enhancement
end note

@enduml